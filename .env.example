# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a && . ./.env && set +a && go run ./cmd/router

# --- Model credentials (pick ONE of the two options below) -------------------

# Option A: Gemini Developer API key from https://aistudio.google.com/apikey
# Simplest path. When set, this takes precedence over the Vertex AI config.
export GOOGLE_API_KEY="your-api-key-here"

# Option B: Vertex AI via Application Default Credentials.
# Leave GOOGLE_API_KEY unset and set your project instead, then run
# `gcloud auth application-default login`.
# export GCP_PROJECT_ID="your-gcp-project"

# --- Local server -----------------------------------------------------------

# Port for the router UI. Cloud Run injects this automatically in production.
# export PORT="8080"

# --- Public demo quota ------------------------------------------------------
# Live agent runs invoke Gemini and cost real money (~$0.06-0.08 per full
# 5-phase construction run). The router meters them per client IP so a public
# deployment cannot run up an unbounded bill. The simulated pipeline is
# unmetered and free.
#
# Defaults: 3 runs/day, 2 runs/minute.
# export DEMO_RUNS_PER_DAY="3"
# export DEMO_RUNS_PER_MINUTE="2"

# --- Edge proxy (only when fronted by Cloudflare) ---------------------------
# Behind a proxy every request arrives from the proxy's IP, so the rightmost
# X-Forwarded-For entry is useless for per-visitor accounting. Set this to read
# CF-Connecting-IP instead, which Cloudflare overwrites and clients cannot forge.
#
# Only safe together with ORIGIN_SHARED_SECRET below — otherwise anyone who
# finds the origin URL can forge CF-Connecting-IP and mint unlimited quota.
# export TRUST_CLOUDFLARE="true"

# Shared secret injected by a Cloudflare Transform Rule as X-Origin-Auth.
# Metered endpoints reject requests without it, so the bare origin URL cannot
# be used to bypass the quota. Leave unset for local development.
# export ORIGIN_SHARED_SECRET="generate-with-openssl-rand-base64-32"
