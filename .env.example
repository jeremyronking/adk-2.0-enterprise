# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a && . ./.env && set +a && go run ./cmd/router

# --- Model credentials (pick ONE of the two options below) -------------------

# Option A: Gemini Developer API key from https://aistudio.google.com/apikey
# Simplest path. When set, this takes precedence over the Vertex AI config.
export GOOGLE_API_KEY="your-api-key-here"

# Option B: Vertex AI via Application Default Credentials.
# Leave GOOGLE_API_KEY unset and set your project instead, then run
# `gcloud auth application-default login`.
# export GCP_PROJECT_ID="your-gcp-project"

# --- Local server -----------------------------------------------------------

# Port for the router UI. Cloud Run injects this automatically in production.
# export PORT="8080"

# --- Public demo quota ------------------------------------------------------
# Live agent runs invoke Gemini and cost real money (~$0.06-0.08 per full
# 5-phase construction run). The router meters them per client IP so a public
# deployment cannot run up an unbounded bill. The simulated pipeline is
# unmetered and free.
#
# Defaults: 3 runs/day, 2 runs/minute.
# export DEMO_RUNS_PER_DAY="3"
# export DEMO_RUNS_PER_MINUTE="2"
